    "question": "How much do YOU earn per month?",
    "hint": "Your personal income only",
    "options": {
      "0": "No income", "1000": "Under ₹1,000", "2500": "₹1,000 – ₹2,500",
      "5000": "₹2,500 – ₹5,000", "8000": "₹5,000 – ₹8,000",
      "12000": "₹8,000 – ₹12,000", "20000": "₹12,000 – ₹20,000", "35000": "Above ₹20,000"
    }
  },
  "family_monthly_income": {
    "question": "What is your total FAMILY income per month?",
    "hint": "Include all earning members in your household",
    "options": {
      "0": "No income", "3000": "Under ₹3,000", "8000": "₹3,000 – ₹8,000",
      "15000": "₹8,000 – ₹15,000", "25000": "₹15,000 – ₹25,000",
      "50000": "₹25,000 – ₹50,000", "100000": "Above ₹50,000"
