  "education_level": {
    "question": "What is your highest education?",
    "options": {
      "illiterate": "Cannot read/write", "primary": "Primary (1–5)",
      "middle": "Middle (6–8)", "matriculation": "Matric / 10th",
      "higher_secondary": "12th / Intermediate", "graduate": "Graduate",
      "postgraduate": "Post-Graduate", "professional": "Professional (MBBS, BE, etc.)"
    }
  },
  "student_class_level": { "question": "Which class / year are you in?", "placeholder": "e.g. Class 10, 1st year B.A." },
