  "occupation": {
    "question": "What is your main work?",
    "options": {
      "farmer": "Farmer (own land)", "marginal_farmer": "Small Farmer (< 2 acres)",
      "farm_laborer": "Farm Labourer", "fisherman": "Fisherman",
      "weaver": "Weaver", "artisan": "Artisan / Craftsperson",
      "self_employed": "Self-Employed", "street_vendor": "Street Vendor",
      "daily_wage": "Daily Wage Worker", "construction_worker": "Construction Worker",
      "domestic_worker": "Domestic Worker", "small_trader": "Small Trader",
      "student": "Student", "homemaker": "Homemaker",
      "unemployed": "Unemployed", "other": "Other"
    }
  },
  "land_holding_acres": { "question": "How many acres of land do you own?", "hint": "Enter 0 if none", "placeholder": "e.g. 2.5" },
