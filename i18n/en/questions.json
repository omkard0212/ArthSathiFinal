{
  "preferred_language": { "question": "Choose your language", "hint": "Select the language you are most comfortable with" },
  "interaction_mode": {
    "question": "How would you like to use ArthSathi?",
    "options": {
      "text": { "label": "Type & Read", "desc": "Read questions, type answers" },
      "voice": { "label": "Speak & Listen", "desc": "Listen to questions, speak answers" }
    }
  },
  "state":    { "question": "Which state do you live in?" },
  "district": { "question": "Which district?", "placeholder": "e.g. Pune, Varanasi" },
  "age":      { "question": "How old are you?", "placeholder": "e.g. 35" },
  "gender": {
    "question": "What is your gender?",
    "options": { "male": "Male", "female": "Female", "transgender": "Transgender", "prefer_not_to_say": "Prefer not to say" }
  },
  "marital_status": {
    "question": "What is your marital status?",
    "options": { "single": "Single", "married": "Married", "widowed": "Widowed", "divorced": "Divorced", "separated": "Separated" }
  },
  "is_widow": { "question": "Are you a widow?" },
  "caste_category": {
    "question": "What is your caste category?",
    "options": { "general": "General / Open", "obc": "OBC", "sc": "SC (Scheduled Caste)", "st": "ST (Scheduled Tribe)", "ews": "EWS (Economically Weaker)", "nt": "NT (Nomadic Tribe)", "other": "Other" }
  },
  "religion": {
    "question": "What is your religion? (optional)",
    "hint": "This helps find minority welfare schemes",
    "options": { "hindu": "Hindu", "muslim": "Muslim", "christian": "Christian", "sikh": "Sikh", "buddhist": "Buddhist", "jain": "Jain", "parsi": "Parsi", "other": "Other", "prefer_not_to_say": "Prefer not to say" }
