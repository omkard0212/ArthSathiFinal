  "residence_type": {
    "question": "Do you live in a rural or urban area?",
    "options": { "rural": "Rural (village)", "semi_urban": "Semi-urban (small town)", "urban": "Urban (city)" }
  },
  "financial_goal": {
    "question": "What is your MAIN financial need right now?",
    "hint": "Choose the one that matters most to you",
    "options": {
      "farming": "Farming (seeds, fertilizer, equipment)",
      "housing": "Build or repair my house",
      "health": "Medical treatment or health care",
      "education": "Education or scholarship",
      "employment": "Job or employment",
      "insurance": "Life or accident insurance",
      "pension": "Pension for old age",
      "business": "Start or grow a business",
      "daughter": "Daughter's welfare / marriage",
      "loan": "Repay a loan or get credit",
      "savings": "Save money for future",
      "disability_support": "Support for my disability",
      "water_sanitation": "Water, toilet, sanitation",
      "skill_training": "Learn a new skill or trade",
      "other": "Something else"
    }
  },
  "goal_description":      { "question": "Describe your need in your own words", "placeholder": "e.g. I need money to buy seeds and fertilizer for the next kharif season", "hint": "More detail = better matches" },
  "goal_amount":           { "question": "How much money do you need for this?", "placeholder": "e.g. 50000" },
  "goal_timeframe_months": {
    "question": "When do you need this?",
    "options": { "1": "Right now (emergency)", "3": "Within 3 months", "6": "Within 6 months", "12": "Within 1 year", "24": "Within 2 years", "60": "Long-term (5+ years)" }
  },
  "urgency_level": {
    "question": "How urgent is this need?",
    "options": { "1": "Not urgent – can wait", "2": "Somewhat urgent", "3": "Moderately urgent", "4": "Very urgent", "5": "Emergency – need help now" }
  },
  "total_debts": { "question": "How much total debt do you currently have?", "placeholder": "e.g. 25000", "hint": "Approximate amount in Rupees" },
  "is_minority": { "question": "Are you from a minority community?" },
  "common": {
    "yes": "Yes", "no": "No", "skip": "Skip", "back": "Back",
    "next": "Next", "finish": "Show My Schemes",
    "step": "Step {{current}} of {{total}}",
    "tap_to_speak": "Tap to speak", "listening": "Listening...",
    "loading": "Loading...", "retry": "Try Again"
